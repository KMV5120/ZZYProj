# ============================================================================
# ZZyProj 平台 - 服务端配置示例
# 复制为 .env 并填写；.env 已在 .gitignore 中
# ============================================================================

ZZY_ENV=production
ZZY_VERSION=ZZY_1.0.0

# 至少 32 位随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
ZZY_JWT_SECRET=

# 模型（只在服务端）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 配额默认值（-1=不限）
ZZY_DAILY_LIMIT=30
ZZY_MONTHLY_TOKEN_LIMIT=1000000

# 网易 163 SMTP：465=SSL（推荐），587=STARTTLS
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=轻量化语言模型

# 显式管理员（逗号分隔）。留空 = 没有任何管理员；需要时填写并重建容器，
# 或使用 tools/create_user.py --role admin 建号。
ZZY_ADMIN_EMAILS=
